{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": ["**", "!dist", "!coverage", "!examples", "!lcov.info"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 300
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noArguments": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noInnerDeclarations": "off",
        "noInvalidUseBeforeDeclaration": "off",
        "noUnusedFunctionParameters": "off",
        "noUnusedVariables": "off",
        "useParseIntRadix": "off"
      },
      "style": {
        "useNodejsImportProtocol": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off",
        "noGlobalIsNan": "off",
        "noRedeclare": "off",
        "noThenProperty": "off"
      }
    }
  }
}
